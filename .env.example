# Copy to .env for local development. Non-secret defaults only - real secrets
# (DISCORD_TOKEN, OPENAI_API_KEY, ANTHROPIC_API_KEY) are injected at deploy,
# never committed. .env itself is gitignored: the deploy tooling writes its
# own .env into the checkout, so a tracked one breaks git pull on the server.

# openai | anthropic | none
AI_PROVIDER=none
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
